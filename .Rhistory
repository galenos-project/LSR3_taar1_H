# 0) Get the actual data frame inside `prisma`
df <- if (is.data.frame(prisma)) {
prisma
} else if (!is.null(prisma$data) && is.data.frame(prisma$data)) {
prisma$data
} else if (!is.null(prisma$df) && is.data.frame(prisma$df)) {
prisma$df
} else {
stop("Couldn't find a data frame inside `prisma`. Try: prisma <- PRISMA_data(csv_path)")
}
PRISMA_flowdiagram(prisma, previous = TRUE, other=FALSE, label_wrap=100)
