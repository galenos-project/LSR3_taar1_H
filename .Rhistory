prisma<-read.csv("data_u1/LSR3_H_PRISMA_2025.08.15.csv") #csv file for the prisma2020
library(dplyr)
library(tidyr)
library(stringr)
# 1) Clean text cols in-place
prisma$data <- prisma$data %>%
mutate(across(c(boxtext, description, tooltips, url, data, node, box),
~ replace_na(as.character(.x), ""))) %>%
# collapse any accidental multi-element values to ONE string
mutate(across(c(boxtext, description, tooltips),
~ vapply(strsplit(.x, "\n", fixed = TRUE),
function(v) paste(v, collapse = " "),
FUN.VALUE = character(1)))) %>%
# trim / normalize whitespace
mutate(across(c(boxtext, description, tooltips),
~ str_squish(.x)))
prisma$boxtext[is.na(prisma$boxtext)] <- ""
prisma$description[is.na(prisma$description)] <- ""
prisma$tooltips[is.na(prisma$tooltips)] <- ""
prisma<-PRISMA_data(prisma)
