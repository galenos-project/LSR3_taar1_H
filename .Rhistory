# Loading
studies<-read_xlsx('data_u1/studies_2025-08-15_LSR3_H.xlsx', na = "NA") #Descriptive data set with included trials
data <- read_xlsx('data_u1/data_2025-08-15_LSR3_H.xlsx') #Clean data with the RCTs with available data
data_doses<-read_xlsx("data_u1/data_doses_2025-08-15_LSR3_H.xlsx") #Effect sizes for the individual doses of TAAR1 (for a descriptive figure)
ae_categories<-read_xlsx("data_u1/ae_categories.xlsx") #Supporting file with the names of adverse events for the summary plot for the side-effects
ae_categories<-ae_categories %>%
select(event_text, MedDRA_an, MedDRA_group) %>%
rename(outcome=MedDRA_an)
#prisma data
prisma<-read.csv("data_u1/LSR3_H_PRISMA_2025.08.15.csv") #csv file for the prisma2020
prisma<-PRISMA_data(prisma)
#risk of bias data
rob<-read_xlsx("data_u1/rob_secondary_2025.08.15.xlsx")
#results matrix table
results_matrix<-read_xlsx("data_u1/reporting_bias_table_2025.08.15.xlsx")
#SoE tables
soe_sch_ac_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 1)
soe_sch_neg_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 2)
soe_sch_neg_ta1_pl_addon_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 3)
soe_sch_stab_ta1_apd_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 4)
soe_sch_ac_ta1_apd_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 5)
soe_pd_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 6)
soe_all_ta1_pl_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 7)
soe_all_ta1_pl_addon_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 8)
soe_all_ta1_apd_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 9)
soe_mechanistic<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 10)
#Round off results to two digits
options(scipen=1, digits=2)
ggplot(data=efficacy_primary,
aes(y=factor(event_text, level=rev(level_outcomes)), x=point))+
geom_text(aes(x=-0.9, label=n_text), colour="black" , position=position_dodge(width = 0.9), vjust=1.5)+
geom_point(size=4,#aes(size=n),
position=position_dodge(width = 0.5), colour="royalblue4")+ #Size proportional to the number of participants
coord_cartesian(xlim=c(-1.2,1.2))+
geom_errorbarh(aes(x=point, xmin=lb,
xmax=ub), height=0.1,
width=0, position=position_dodge(width = 0.5), colour="royalblue4")+
scale_size_continuous(guide=FALSE)+
geom_vline(xintercept=0, linetype='solid')+
facet_grid(~factor(population, levels=level_population))+
ylab("")+
xlab("SMD 95%CI (SMD>0: TAAR1 agonist better)")+
theme_bw()+
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(),  # keeps vertical major grid lines
panel.grid.minor.x = element_blank(),
axis.ticks.y = element_blank(),
strip.background = element_blank(),
strip.text = element_text(face = "bold"))
### libraries
library(meta)
library(tidyverse)
library(tibble)
library(stringr)
library(readxl)
library(grid)
library(dplyr)
library(knitr)
library(kableExtra)
library(devtools)
#library(metafor)
library(robvis) #Need to install from devtools::install_github("mcguinlu/robvis")
library(PRISMA2020)
library(grateful)
#devtools::install_github("haozhu233/kableExtra") I need to remove this, otherwise the R markdown didnt work
#Empty the enviroment
rm(list=ls())
# Set option defaults
knitr::opts_chunk$set(echo = T, warning = F, message = F)
#Data cleaning routines
source("data_u1/clean_data.R")
#Data analysis routines and functions
source("util_u1/analysis.R")
# Loading
studies<-read_xlsx('data_u1/studies_2025-08-15_LSR3_H.xlsx', na = "NA") #Descriptive data set with included trials
data <- read_xlsx('data_u1/data_2025-08-15_LSR3_H.xlsx') #Clean data with the RCTs with available data
data_doses<-read_xlsx("data_u1/data_doses_2025-08-15_LSR3_H.xlsx") #Effect sizes for the individual doses of TAAR1 (for a descriptive figure)
ae_categories<-read_xlsx("data_u1/ae_categories.xlsx") #Supporting file with the names of adverse events for the summary plot for the side-effects
ae_categories<-ae_categories %>%
select(event_text, MedDRA_an, MedDRA_group) %>%
rename(outcome=MedDRA_an)
#prisma data
prisma<-read.csv("data_u1/LSR3_H_PRISMA_2025.08.15.csv") #csv file for the prisma2020
prisma<-PRISMA_data(prisma)
#risk of bias data
rob<-read_xlsx("data_u1/rob_secondary_2025.08.15.xlsx")
#results matrix table
results_matrix<-read_xlsx("data_u1/reporting_bias_table_2025.08.15.xlsx")
#SoE tables
soe_sch_ac_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 1)
soe_sch_neg_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 2)
soe_sch_neg_ta1_pl_addon_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 3)
soe_sch_stab_ta1_apd_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 4)
soe_sch_ac_ta1_apd_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 5)
soe_pd_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 6)
soe_all_ta1_pl_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 7)
soe_all_ta1_pl_addon_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 8)
soe_all_ta1_apd_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 9)
soe_mechanistic<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 10)
#Round off results to two digits
options(scipen=1, digits=2)
outcome_categories<-outcome_names %>%
select(outcome, event_text)
efficacy_primary<-meta_outcome %>% left_join(outcome_categories) %>%
filter(outcome=="cognition" | outcome=="depression" | outcome=="negative" | outcome=="overall" | outcome=="positive") %>% #efficacy outcome
filter(!is.na(TE.random)) %>% filter(!is.na(event_text)) %>%
mutate(point=TE.random,
lb=TE_lb.random,
ub=TE_ub.random) %>%
unique() %>%
filter(comparison=="taar1_vs_placebo") %>%
mutate(n_text=paste0("N=", k,", n=",n))
efficacy_primary$population <- factor(efficacy_primary$population, levels=unique(efficacy_primary$population))
efficacy_primary$event_text <- factor(efficacy_primary$event_tex, levels=unique(efficacy_primary$event_tex))
level_outcomes<- c("Overall symptoms", "Positive symptoms", "Negative symptoms", "Depressive symptoms", "Cognitive impairement")
level_population<-c("Schizophrenia spectrum (acute episode)","Schizophrenia spectrum (negative symptoms)", "Parkinson Disease Psychosis")
ggplot(data=efficacy_primary,
aes(y=factor(event_text, level=rev(level_outcomes)), x=point))+
geom_text(aes(x=-0.9, label=n_text), colour="black" , position=position_dodge(width = 0.9), vjust=1.5)+
geom_point(size=4,#aes(size=n),
position=position_dodge(width = 0.5), colour="royalblue4")+ #Size proportional to the number of participants
coord_cartesian(xlim=c(-1.2,1.2))+
geom_errorbarh(aes(x=point, xmin=lb,
xmax=ub), height=0.1,
width=0, position=position_dodge(width = 0.5), colour="royalblue4")+
scale_size_continuous(guide=FALSE)+
geom_vline(xintercept=0, linetype='solid')+
facet_grid(~factor(population, levels=level_population))+
ylab("")+
xlab("SMD 95%CI (SMD>0: TAAR1 agonist better)")+
theme_bw()+
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank(),
panel.grid.major.x = element_line(),  # keeps vertical major grid lines
panel.grid.minor.x = element_blank(),
axis.ticks.y = element_blank(),
strip.background = element_blank(),
strip.text = element_text(face = "bold"))
### libraries
library(meta)
library(tidyverse)
library(tibble)
library(stringr)
library(readxl)
library(grid)
library(dplyr)
library(knitr)
library(kableExtra)
library(devtools)
#library(metafor)
library(robvis) #Need to install from devtools::install_github("mcguinlu/robvis")
library(PRISMA2020)
library(grateful)
#devtools::install_github("haozhu233/kableExtra") I need to remove this, otherwise the R markdown didnt work
#Empty the enviroment
rm(list=ls())
# Set option defaults
knitr::opts_chunk$set(echo = T, warning = F, message = F)
#Data cleaning routines
source("data_u1/clean_data.R")
#Data analysis routines and functions
source("util_u1/analysis.R")
# Loading
studies<-read_xlsx('data_u1/studies_2025-08-15_LSR3_H.xlsx', na = "NA") #Descriptive data set with included trials
data <- read_xlsx('data_u1/data_2025-08-15_LSR3_H.xlsx') #Clean data with the RCTs with available data
data_doses<-read_xlsx("data_u1/data_doses_2025-08-15_LSR3_H.xlsx") #Effect sizes for the individual doses of TAAR1 (for a descriptive figure)
ae_categories<-read_xlsx("data_u1/ae_categories.xlsx") #Supporting file with the names of adverse events for the summary plot for the side-effects
ae_categories<-ae_categories %>%
select(event_text, MedDRA_an, MedDRA_group) %>%
rename(outcome=MedDRA_an)
#prisma data
prisma<-read.csv("data_u1/LSR3_H_PRISMA_2025.08.15.csv") #csv file for the prisma2020
prisma<-PRISMA_data(prisma)
#risk of bias data
rob<-read_xlsx("data_u1/rob_secondary_2025.08.15.xlsx")
#results matrix table
results_matrix<-read_xlsx("data_u1/reporting_bias_table_2025.08.15.xlsx")
#SoE tables
soe_sch_ac_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 1)
soe_sch_neg_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 2)
soe_sch_neg_ta1_pl_addon_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 3)
soe_sch_stab_ta1_apd_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 4)
soe_sch_ac_ta1_apd_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 5)
soe_pd_ta1_pl_eff<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 6)
soe_all_ta1_pl_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 7)
soe_all_ta1_pl_addon_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 8)
soe_all_ta1_apd_saf<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 9)
soe_mechanistic<-read_xlsx("data_u1/soe_tables_2025.08.15.xlsx", sheet = 10)
#Round off results to two digits
options(scipen=1, digits=2)
safety_primary3<-meta_outcome %>% left_join(ae_categories) %>%
mutate(event_text=ifelse(outcome=="death", "Mortality",
ifelse(outcome=="serious", "Serious event",
ifelse(outcome=="dropout_any", "Dropouts any reason",
ifelse(outcome=="dropout_ae", "Dropouts adverse event", event_text)))),
MedDRA_group=ifelse(outcome=="death" | outcome=="serious", "serious",
ifelse(outcome=="dropout_any" | outcome=="dropout_ae", "dropouts", MedDRA_group))) %>%
filter(!is.na(TE.random)) %>% filter(!is.na(event_text)) %>%
mutate(point=TE.random,
lb=TE.random-1.96*seTE.random,
ub=TE.random+1.96*seTE.random) %>% unique() %>%
filter(comparison=="taar1_vs_placebo_addon") %>%
mutate(n_text=paste0("N=", k,", n=",n))
safety_primary_plot3 <-safety_primary3
safety_primary_plot3$timepoint <- factor(safety_primary_plot3$timepoint,
levels = c("1 day-2 weeks", "3-13 weeks", ">13 weeks"))
safety_primary_plot3$event_text <- factor(safety_primary_plot3$event_tex, levels=unique(safety_primary_plot3$event_tex))
level_order<- sort(unique(safety_primary_plot3$event_text))
lever_order_meddra<-c("dropouts", "any", "serious", "autonomic", "endocrinic", "neuromuscular", "neuropsychiatric")
safety_primary_plot3$event_text <- factor(safety_primary_plot3$event_tex, levels=unique(safety_primary_plot3$event_tex))
level_order<- sort(unique(safety_primary_plot$event_text))
