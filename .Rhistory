geom_pointrange(aes(x = 0.55, y = meta_comp_overall_sch$TE.fixed, ymin = meta_comp_overall_sch$TE.fixed- 1.96*meta_comp_overall_sch$seTE.fixed, ymax =  meta_comp_overall_sch$TE.fixed+ 1.96*meta_comp_overall_sch$seTE.fixed, colour="fixed"), size = 1) +
